\documentclass[11pt, a4paper]{report}

% Language setting — Greek primary, English secondary (polyglossia for XeLaTeX)
\usepackage{polyglossia}
\setmainlanguage{greek}
\setotherlanguage{english}
% Patch: some polyglossia versions write \selectlanguage*{...} to aux file
% which fails if the starred form is not defined. This makes * optional.
\makeatletter
\let\@poly@selectlanguage\selectlanguage
\def\selectlanguage{\@ifstar\@poly@selectlanguage\@poly@selectlanguage}
\makeatother

% Page size and margins
\usepackage[a4paper, top=2.5cm, bottom=2.5cm, left=3cm, right=2.5cm, headheight=14pt]{geometry}

% Math
\usepackage{amsmath}
\usepackage{amssymb}

% Graphics
\usepackage{graphicx}
\usepackage[export]{adjustbox}
\usepackage{float}
\usepackage{subcaption}
\graphicspath{{../thesis_output/}}

% Tables
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{multirow}
\usepackage{array}
\usepackage{tabularx}
\usepackage{makecell}
\usepackage{xcolor}
\usepackage{colortbl}

% Links
\usepackage[hidelinks, breaklinks]{hyperref}
% cleveref removed — Greek polyglossia incompatible; using \ref{} directly

% Bibliography (natbib fallback; use biblatex on full TeX installation)
\usepackage[numbers, sort&compress]{natbib}

% Font (Calibri — Windows; change to DejaVu Sans on Linux)
\usepackage{fontspec}
\setmainfont[Script=Greek]{Calibri}
\newfontfamily\greekfont[Script=Greek]{Calibri}
\newfontfamily\greekfontsf[Script=Greek]{Calibri}
\newfontfamily\greekfonttt[Script=Greek]{Courier New}
\usepackage{microtype}
% Zero indentation style (matching UPAT ECE template)
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
% Looser justification — prevents rivers/overfull hboxes in Greek
\tolerance=1500
\emergencystretch=2em
\hyphenpenalty=500
\exhyphenpenalty=500

% PDF pages (for cover)
\usepackage{pdfpages}

% Euro symbol
\usepackage{eurosym}   % provides \euro{}

% Units
