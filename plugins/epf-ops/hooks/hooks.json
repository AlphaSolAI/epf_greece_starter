{
  "PreToolUse": [
    {
      "matcher": "Edit|Write|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "python -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard_edits.py\"",
          "timeout": 15
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "python -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/qa_nudges.py\"",
          "timeout": 15
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "python -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/qa_nudges.py\"",
          "timeout": 15
        }
      ]
    }
  ]
}
